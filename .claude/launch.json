{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "web",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-attach",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}

.DS_Store
data
.venv
.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
__pycache__/

# Local planning docs — intermediate step between a GitHub issue and its beads issues
plans/

# Exploratory notebooks. Local scratch for poking at the parquet inputs by hand;
# what the columns mean and which ones build_dataset.py reads lives in
# jobs/README.md instead. Committing them means committing execution counts and
# cell outputs, which diff badly and can carry data out of the gitignored data/.
*.ipynb

# bd 1.3 writes a workspace lock file beside .beads (.beads.gate.lock).
*.gate.lock*

# Agent and tool interaction log, written by bd 0.62 and by bd 1.3 when
# audit.enabled is on. Ignored here rather than in .beads/.gitignore because
# bd regenerates that file and the 1.3 version dropped this rule. The repo is
# public, so committing it would publish those records.
.beads/interactions.jsonl
